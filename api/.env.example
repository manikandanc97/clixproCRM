PORT=4000
DATABASE_URL=your_database_url
DIRECT_URL=your_direct_url
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ALLOWED_ORIGINS=https://clixprocrm.vercel.app,http://localhost:3000

# ─── Field-Level Encryption Key (AES-256-GCM) ─────────────────────────────────
# REQUIRED in production. Must be exactly 64 hex characters (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit this to git. Store in your secret manager (AWS Secrets Manager, Vault, etc.)
# The app will REFUSE to start if this is not set.
FIELD_ENCRYPTION_KEY=your_64_hex_char_encryption_key_here
