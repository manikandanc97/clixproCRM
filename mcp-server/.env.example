# ==============================================================================
# ClixProCRM MCP Server - Environment Configuration
# STEP 5: MCP SECURITY, SESSION CONTEXT & MUTATION HARDENING
# ==============================================================================

# Server Metadata
MCP_SERVER_NAME=clixprocrm-mcp-server
MCP_SERVER_VERSION=0.1.0

# CRM API Gateway URL
# Local Development: http://localhost:4000 (or http://localhost:3000)
# Production Example: https://api.clixprocrm.com
# NOTE: MCP communicates STRICTLY via this authorized API gateway.
# Direct database connections, raw credentials, and Supabase service keys are strictly prohibited.
CRM_API_BASE_URL=http://localhost:4000

# API Request Timeout in Milliseconds (Default: 10000 = 10s)
CRM_REQUEST_TIMEOUT_MS=10000

# Logging Configuration (debug | info | warn | error)
# Note: Diagnostic logs are written to STDERR; Authorization headers and credentials are NEVER logged.
LOG_LEVEL=info

# MCP Client-Side Safety Rate Limiter (Protects against AI tool loops / request flooding)
MCP_RATE_LIMIT_ENABLED=true
MCP_RATE_LIMIT_MAX_REQUESTS=60
MCP_RATE_LIMIT_WINDOW_MS=60000

# Request Body & Payload Limits
MCP_MAX_PAYLOAD_SIZE_BYTES=102400

