generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  plan          String         @default("free")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  customers     Customer[]
  departments   Department[]
  invitations   Invitation[]
  invoices      Invoice[]
  leads         Lead[]
  meetings      Meeting[]
  notifications Notification[]
  products      Product[]
  quotations    Quotation[]
  roles         Role[]
  tasks         Task[]
  users         TenantUser[]
  revenueTargets RevenueTarget[]
  notes          Note[]
  timelineEvents TimelineEvent[]
  attachments    Attachment[]
}

model User {
  id                  String       @id @default(uuid())
  name                String
  email               String       @unique
  password            String
  status              UserStatus   @default(ACTIVE)
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  twoFactorEnabled    Boolean      @default(false)
  twoFactorSecret     String?
  resetToken          String?
  resetTokenExpiry    DateTime?
  deletedAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  auditLogsTarget     AuditLog[]   @relation("AuditLogTarget")
  auditLogsActed      AuditLog[]   @relation("AuditLogActor")
  assignedCustomers   Customer[]   @relation("CustomerAssignedTo")
  assignedLeads       Lead[]       @relation("LeadAssignedTo")
  createdLeads        Lead[]       @relation("LeadCreatedBy")
  updatedLeads        Lead[]       @relation("LeadUpdatedBy")
  assignedQuotations  Quotation[]  @relation("QuotationAssignedTo")
  sessions            Session[]
  assignedTasks       Task[]       @relation("TaskAssignedTo")
  createdTasks        Task[]       @relation("TaskCreatedBy")
  assignedMeetings    Meeting[]    @relation("MeetingAssignedTo")
  memberships         TenantUser[]
  notes               Note[]       @relation("NoteAuthor")
  timelineEvents      TimelineEvent[] @relation("TimelineEventActor")
  attachments         Attachment[] @relation("AttachmentUploader")
}

model TenantUser {
  id                 String       @id @default(uuid())
  tenantId           String
  userId             String
  roleId             String
  departmentId       String?
  reportingManagerId String?
  status             UserStatus   @default(ACTIVE)
  joinedAt           DateTime     @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  department         Department?  @relation(fields: [departmentId], references: [id])
  reportingManager   TenantUser?  @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  subordinates       TenantUser[] @relation("ReportingManager")
  role               Role         @relation(fields: [roleId], references: [id])
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([departmentId])
}

model Customer {
  id            String         @id @default(uuid())
  tenantId      String
  assignedToId  String?
  name          String
  company       String
  email         String?
  status        CustomerStatus @default(ACTIVE)
  revenue       Decimal        @default(0) @db.Decimal(12, 2)
  lastContactAt DateTime?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assignedTo    User?          @relation("CustomerAssignedTo", fields: [assignedToId], references: [id])
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotations    Quotation[]
  leadId        String?
  leads         Lead[]         @relation("LeadCustomer")
  tasks         Task[]         @relation("TaskCustomer")
  meetings      Meeting[]

  @@index([tenantId, status])
  @@index([assignedToId])
}

model Lead {
  id                String       @id @default(uuid())
  tenantId          String
  name              String
  company           String
  email             String
  phone             String?
  source            String       @default("Direct")
  stage             LeadStage    @default(NEW)
  priority          LeadPriority @default(MEDIUM)
  assignedToId      String?
  value             Decimal      @default(0) @db.Decimal(12, 2)
  expectedCloseDate DateTime?
  tags              String[]
  lastActivityAt    DateTime     @default(now())
  createdById       String?
  updatedById       String?
  isConverted       Boolean      @default(false)
  convertedAt       DateTime?
  customerId        String?
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  customer          Customer?    @relation("LeadCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo        User?        @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  createdBy         User?        @relation("LeadCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?        @relation("LeadUpdatedBy", fields: [updatedById], references: [id])
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  meetings          Meeting[]
  notes             Note[]
  timelineEvents    TimelineEvent[]
  attachments       Attachment[]
  tasks             Task[]         @relation("TaskLead")
  quotations        Quotation[]

  @@index([tenantId, stage])
  @@index([assignedToId])
  @@index([customerId])
}

model Task {
  id                      String       @id @default(uuid())
  tenantId                String
  title                   String
  description             String?
  status                  TaskStatus   @default(PENDING)
  priority                TaskPriority @default(MEDIUM)
  dueDate                 DateTime?
  reminderDate            DateTime?
  assignedToId            String?
  createdById             String?
  relatedLeadId           String?
  relatedCustomerId       String?
  relatedMeetingId        String?
  relatedQuotationId      String?
  tags                    String[]     @default([])
  checklist               Json?
  attachments             Json?
  completedAt             DateTime?
  deletedAt               DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  assignedTo       User?      @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdBy        User?      @relation("TaskCreatedBy", fields: [createdById], references: [id])
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  relatedLead      Lead?      @relation("TaskLead", fields: [relatedLeadId], references: [id], onDelete: SetNull)
  relatedCustomer  Customer?  @relation("TaskCustomer", fields: [relatedCustomerId], references: [id], onDelete: SetNull)
  relatedMeeting   Meeting?   @relation("TaskMeeting", fields: [relatedMeetingId], references: [id], onDelete: SetNull)
  relatedQuotation Quotation? @relation("TaskQuotation", fields: [relatedQuotationId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([assignedToId])
  @@index([createdById])
  @@index([relatedLeadId])
  @@index([relatedCustomerId])
}

model Quotation {
  id           String          @id @default(uuid())
  tenantId     String
  customerId   String?
  assignedToId String?
  leadId       String
  quoteNumber  String
  client       String
  amount       Decimal         @default(0) @db.Decimal(12, 2)
  discount     Decimal?        @default(0) @db.Decimal(12, 2)
  tax          Decimal?        @default(0) @db.Decimal(12, 2)
  items        Json?
  notes        String?
  status       QuotationStatus @default(DRAFT)
  validTill    DateTime?
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  assignedTo   User?           @relation("QuotationAssignedTo", fields: [assignedToId], references: [id])
  customer     Customer?       @relation(fields: [customerId], references: [id])
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead         Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tasks        Task[]          @relation("TaskQuotation")
  meetings     Meeting[]

  @@unique([tenantId, quoteNumber])
  @@index([customerId])
  @@index([assignedToId])
  @@index([leadId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String?
  userId       String?
  targetUserId String?
  action       String
  module       String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  targetUser   User?    @relation("AuditLogTarget", fields: [targetUserId], references: [id])
  user         User?    @relation("AuditLogActor", fields: [userId], references: [id])

  @@index([userId])
  @@index([targetUserId])
  @@index([tenantId])
}

model Invitation {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  roleId    String
  token     String   @unique
  expiresAt DateTime
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String
  name        String
  description String?
  color       String?
  priority    Int              @default(0)
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  invitations Invitation[]
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       TenantUser[]

  @@unique([tenantId, name])
}

model Department {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       TenantUser[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RolePermission {
  roleId    String
  module    String
  hasAccess Boolean @default(true)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, module])
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  sku         String?
  description String?
  price       Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Invoice {
  id         String    @id @default(uuid())
  tenantId   String
  customerId String
  amount     Decimal   @default(0) @db.Decimal(12, 2)
  status     String    @default("DRAFT")
  dueDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
}

model Meeting {
  id            String    @id @default(uuid())
  tenantId      String
  title         String
  startTime     DateTime
  endTime       DateTime
  duration      Int       @default(30)
  location      String?
  isOnline      Boolean   @default(false)
  type          EventType @default(MEETING)
  description   String?
  isAllDay      Boolean   @default(false)
  assignedToId  String?
  leadId        String?
  customerId    String?
  quotationId   String?
  status        String    @default("SCHEDULED")
  reminderAt    DateTime?
  participants  Json?
  meetingNotes  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo    User?     @relation("MeetingAssignedTo", fields: [assignedToId], references: [id])
  lead          Lead?     @relation(fields: [leadId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])
  quotation     Quotation? @relation(fields: [quotationId], references: [id])
  tasks         Task[]    @relation("TaskMeeting")

  @@index([tenantId])
  @@index([assignedToId])
  @@index([leadId])
  @@index([customerId])
  @@index([quotationId])
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("INFO")
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerStatus {
  PREMIUM
  ACTIVE
  INACTIVE
}

enum LeadStage {
  NEW
  CONTACTED
  PROPOSAL_SENT
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
  OVERDUE
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum EventType {
  MEETING
  CALL
  HOLIDAY
  BIRTHDAY
  LEAVE
  FOLLOW_UP
}

model RevenueTarget {
  id               String       @id @default(uuid())
  tenantId         String
  periodType       TargetPeriod @default(MONTHLY)
  value            Decimal      @default(0) @db.Decimal(12, 2)
  currency         String       @default("USD")
  startDate        DateTime
  endDate          DateTime
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
}

enum TargetPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

model Note {
  id        String   @id @default(uuid())
  tenantId  String
  leadId    String
  userId    String
  message   String
  isPinned  Boolean  @default(false)
  isInternal Boolean @default(true)
  mentions  Json?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User     @relation("NoteAuthor", fields: [userId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([leadId])
  @@index([userId])
}

model TimelineEvent {
  id          String   @id @default(uuid())
  tenantId    String
  leadId      String
  userId      String?
  action      String
  description String?
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User?    @relation("TimelineEventActor", fields: [userId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([leadId])
}

model Attachment {
  id          String   @id @default(uuid())
  tenantId    String
  leadId      String
  userId      String
  fileName    String
  fileUrl     String
  fileSize    Int
  fileType    String
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User     @relation("AttachmentUploader", fields: [userId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([leadId])
}
