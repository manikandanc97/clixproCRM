generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  plan          String         @default("free")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  customers     Customer[]
  departments   Department[]
  invitations   Invitation[]
  invoices      Invoice[]
  leads         Lead[]
  meetings      Meeting[]
  notifications Notification[]
  products      Product[]
  quotations    Quotation[]
  roles         Role[]
  tasks         Task[]
  users         TenantUser[]
}

model User {
  id                  String       @id @default(uuid())
  name                String
  email               String       @unique
  password            String
  status              UserStatus   @default(ACTIVE)
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  twoFactorEnabled    Boolean      @default(false)
  twoFactorSecret     String?
  resetToken          String?
  resetTokenExpiry    DateTime?
  deletedAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  auditLogsTarget     AuditLog[]   @relation("AuditLogTarget")
  auditLogsActed      AuditLog[]   @relation("AuditLogActor")
  assignedCustomers   Customer[]   @relation("CustomerAssignedTo")
  assignedLeads       Lead[]       @relation("LeadAssignedTo")
  assignedQuotations  Quotation[]  @relation("QuotationAssignedTo")
  sessions            Session[]
  assignedTasks       Task[]       @relation("TaskAssignedTo")
  memberships         TenantUser[]
}

model TenantUser {
  id                 String       @id @default(uuid())
  tenantId           String
  userId             String
  roleId             String
  departmentId       String?
  reportingManagerId String?
  status             UserStatus   @default(ACTIVE)
  joinedAt           DateTime     @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  department         Department?  @relation(fields: [departmentId], references: [id])
  reportingManager   TenantUser?  @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  subordinates       TenantUser[] @relation("ReportingManager")
  role               Role         @relation(fields: [roleId], references: [id])
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([departmentId])
}

model Customer {
  id            String         @id @default(uuid())
  tenantId      String
  assignedToId  String?
  name          String
  company       String
  email         String?
  status        CustomerStatus @default(ACTIVE)
  revenue       Decimal        @default(0) @db.Decimal(12, 2)
  lastContactAt DateTime?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assignedTo    User?          @relation("CustomerAssignedTo", fields: [assignedToId], references: [id])
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotations    Quotation[]

  @@index([tenantId, status])
  @@index([assignedToId])
}

model Lead {
  id           String     @id @default(uuid())
  tenantId     String
  assignedToId String?
  name         String
  company      String
  email        String
  status       LeadStatus @default(NEW)
  value        Decimal    @default(0) @db.Decimal(12, 2)
  followUpAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  competitor   String?
  lostReason   String?
  priority     String     @default("Medium")
  probability  Int        @default(10)
  wonReason    String?
  phone        String?
  assignedTo   User?      @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([assignedToId])
}

model Task {
  id           String       @id @default(uuid())
  tenantId     String
  assignedToId String?
  title        String
  description  String?
  dueDate      DateTime?
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(PENDING)
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignedTo   User?        @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([assignedToId])
}

model Quotation {
  id           String          @id @default(uuid())
  tenantId     String
  customerId   String?
  assignedToId String?
  quoteNumber  String
  client       String
  amount       Decimal         @default(0) @db.Decimal(12, 2)
  status       QuotationStatus @default(PENDING)
  validTill    DateTime?
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  assignedTo   User?           @relation("QuotationAssignedTo", fields: [assignedToId], references: [id])
  customer     Customer?       @relation(fields: [customerId], references: [id])
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, quoteNumber])
  @@index([customerId])
  @@index([assignedToId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String?
  userId       String?
  targetUserId String?
  action       String
  module       String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  targetUser   User?    @relation("AuditLogTarget", fields: [targetUserId], references: [id])
  user         User?    @relation("AuditLogActor", fields: [userId], references: [id])

  @@index([userId])
  @@index([targetUserId])
  @@index([tenantId])
}

model Invitation {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  roleId    String
  token     String   @unique
  expiresAt DateTime
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String
  name        String
  description String?
  color       String?
  priority    Int              @default(0)
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  invitations Invitation[]
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       TenantUser[]

  @@unique([tenantId, name])
}

model Department {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       TenantUser[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RolePermission {
  roleId    String
  module    String
  hasAccess Boolean @default(true)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, module])
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  sku         String?
  description String?
  price       Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Invoice {
  id         String    @id @default(uuid())
  tenantId   String
  customerId String
  amount     Decimal   @default(0) @db.Decimal(12, 2)
  status     String    @default("DRAFT")
  dueDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
}

model Meeting {
  id        String   @id @default(uuid())
  tenantId  String
  title     String
  startTime DateTime
  endTime   DateTime
  location  String?
  isOnline  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("INFO")
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerStatus {
  PREMIUM
  ACTIVE
  INACTIVE
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  WON
  LOST
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum QuotationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}
