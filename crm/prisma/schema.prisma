generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model Tenant {
  id             String          @id @default(uuid())
  name           String
  slug           String          @unique
  plan           String          @default("free")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  attachments    Attachment[]
  customers      Customer[]
  departments    Department[]
  invitations    Invitation[]
  invoices       Invoice[]
  leads          Lead[]
  meetings       Meeting[]
  notes          Note[]
  notifications  Notification[]
  products       Product[]
  quotations     Quotation[]
  revenueTargets RevenueTarget[]
  roles          Role[]
  tasks          Task[]
  users          TenantUser[]
  timelineEvents TimelineEvent[]
  aiConfig       TenantAiConfig?
  aiConversations AiConversation[]
  documents      Document[]
}

model User {
  id                  String          @id @default(uuid())
  name                String
  email               String          @unique
  password            String
  status              UserStatus      @default(ACTIVE)
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int             @default(0)
  lockedUntil         DateTime?
  twoFactorEnabled    Boolean         @default(false)
  twoFactorSecret     String?
  resetToken          String?
  resetTokenExpiry    DateTime?
  deletedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  attachments         Attachment[]    @relation("AttachmentUploader")
  auditLogsTarget     AuditLog[]      @relation("AuditLogTarget")
  auditLogsActed      AuditLog[]      @relation("AuditLogActor")
  assignedCustomers   Customer[]      @relation("CustomerAssignedTo")
  assignedLeads       Lead[]          @relation("LeadAssignedTo")
  createdLeads        Lead[]          @relation("LeadCreatedBy")
  updatedLeads        Lead[]          @relation("LeadUpdatedBy")
  assignedMeetings    Meeting[]       @relation("MeetingAssignedTo")
  notes               Note[]          @relation("NoteAuthor")
  assignedQuotations  Quotation[]     @relation("QuotationAssignedTo")
  sessions            Session[]
  assignedTasks       Task[]          @relation("TaskAssignedTo")
  createdTasks        Task[]          @relation("TaskCreatedBy")
  memberships         TenantUser[]
  timelineEvents      TimelineEvent[] @relation("TimelineEventActor")
  aiConversations     AiConversation[]
}

model TenantUser {
  id                 String       @id @default(uuid())
  tenantId           String
  userId             String
  roleId             String
  departmentId       String?
  reportingManagerId String?
  status             UserStatus   @default(ACTIVE)
  joinedAt           DateTime     @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  department         Department?  @relation(fields: [departmentId], references: [id])
  reportingManager   TenantUser?  @relation("ReportingManager", fields: [reportingManagerId], references: [id])
  subordinates       TenantUser[] @relation("ReportingManager")
  role               Role         @relation(fields: [roleId], references: [id])
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([departmentId])
}

model Customer {
  id            String         @id @default(uuid())
  tenantId      String
  assignedToId  String?
  name          String
  company       String
  email         String?
  status        CustomerStatus @default(ACTIVE)
  revenue       Decimal        @default(0) @db.Decimal(12, 2)
  lastContactAt DateTime?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  leadId        String?
  assignedTo    User?          @relation("CustomerAssignedTo", fields: [assignedToId], references: [id])
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads         Lead[]         @relation("LeadCustomer")
  meetings      Meeting[]
  quotations    Quotation[]
  tasks         Task[]         @relation("TaskCustomer")

  @@index([tenantId, status])
  @@index([assignedToId])
}

model Lead {
  id                String          @id @default(uuid())
  tenantId          String
  assignedToId      String?
  name              String
  company           String
  email             String
  value             Decimal         @default(0) @db.Decimal(12, 2)
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  phone             String?
  createdById       String?
  expectedCloseDate DateTime?
  lastActivityAt    DateTime        @default(now())
  source            String          @default("Direct")
  stage             LeadStage       @default(NEW)
  tags              String[]
  updatedById       String?
  priority          LeadPriority    @default(MEDIUM)
  isConverted       Boolean         @default(false)
  convertedAt       DateTime?
  customerId        String?
  attachments       Attachment[]
  assignedTo        User?           @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  createdBy         User?           @relation("LeadCreatedBy", fields: [createdById], references: [id])
  customer          Customer?       @relation("LeadCustomer", fields: [customerId], references: [id])
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy         User?           @relation("LeadUpdatedBy", fields: [updatedById], references: [id])
  meetings          Meeting[]
  notes             Note[]
  quotations        Quotation[]
  tasks             Task[]          @relation("TaskLead")
  timelineEvents    TimelineEvent[]

  @@index([tenantId, stage])
  @@index([assignedToId])
  @@index([customerId])
}

model Task {
  id                 String       @id @default(uuid())
  tenantId           String
  assignedToId       String?
  title              String
  description        String?
  dueDate            DateTime?
  priority           TaskPriority @default(MEDIUM)
  status             TaskStatus   @default(PENDING)
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  attachments        Json?
  checklist          Json?
  completedAt        DateTime?
  createdById        String?
  relatedCustomerId  String?
  relatedLeadId      String?
  relatedMeetingId   String?
  relatedQuotationId String?
  reminderDate       DateTime?
  tags               String[]     @default([])
  assignedTo         User?        @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdBy          User?        @relation("TaskCreatedBy", fields: [createdById], references: [id])
  relatedCustomer    Customer?    @relation("TaskCustomer", fields: [relatedCustomerId], references: [id])
  relatedLead        Lead?        @relation("TaskLead", fields: [relatedLeadId], references: [id])
  relatedMeeting     Meeting?     @relation("TaskMeeting", fields: [relatedMeetingId], references: [id])
  relatedQuotation   Quotation?   @relation("TaskQuotation", fields: [relatedQuotationId], references: [id])
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([assignedToId])
  @@index([createdById])
  @@index([relatedLeadId])
  @@index([relatedCustomerId])
}

model Quotation {
  id           String          @id @default(uuid())
  tenantId     String
  customerId   String?
  assignedToId String?
  quoteNumber  String
  client       String
  amount       Decimal         @default(0) @db.Decimal(12, 2)
  status       QuotationStatus @default(DRAFT)
  validTill    DateTime?
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  discount     Decimal?        @default(0) @db.Decimal(12, 2)
  items        Json?
  leadId       String
  notes        String?
  tax          Decimal?        @default(0) @db.Decimal(12, 2)
  meetings     Meeting[]
  assignedTo   User?           @relation("QuotationAssignedTo", fields: [assignedToId], references: [id])
  customer     Customer?       @relation(fields: [customerId], references: [id])
  lead         Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks        Task[]          @relation("TaskQuotation")

  @@unique([tenantId, quoteNumber])
  @@index([customerId])
  @@index([assignedToId])
  @@index([leadId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String?
  userId       String?
  targetUserId String?
  action       String
  module       String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  targetUser   User?    @relation("AuditLogTarget", fields: [targetUserId], references: [id])
  user         User?    @relation("AuditLogActor", fields: [userId], references: [id])

  @@index([userId])
  @@index([targetUserId])
  @@index([tenantId])
}

model Invitation {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  roleId    String
  token     String   @unique
  expiresAt DateTime
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String
  name        String
  description String?
  color       String?
  priority    Int              @default(0)
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  invitations Invitation[]
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       TenantUser[]

  @@unique([tenantId, name])
}

model Department {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       TenantUser[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RolePermission {
  roleId    String
  module    String
  hasAccess Boolean @default(true)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, module])
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  sku         String?
  description String?
  price       Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Invoice {
  id         String    @id @default(uuid())
  tenantId   String
  customerId String
  amount     Decimal   @default(0) @db.Decimal(12, 2)
  status     String    @default("DRAFT")
  dueDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
}

model Meeting {
  id           String     @id @default(uuid())
  tenantId     String
  title        String
  startTime    DateTime
  endTime      DateTime
  location     String?
  isOnline     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignedToId String?
  description  String?
  isAllDay     Boolean    @default(false)
  status       String     @default("SCHEDULED")
  type         EventType  @default(MEETING)
  duration     Int        @default(30)
  leadId       String?
  meetingNotes String?
  participants Json?
  reminderAt   DateTime?
  customerId   String?
  quotationId  String?
  assignedTo   User?      @relation("MeetingAssignedTo", fields: [assignedToId], references: [id])
  customer     Customer?  @relation(fields: [customerId], references: [id])
  lead         Lead?      @relation(fields: [leadId], references: [id])
  quotation    Quotation? @relation(fields: [quotationId], references: [id])
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks        Task[]     @relation("TaskMeeting")

  @@index([tenantId])
  @@index([assignedToId])
  @@index([leadId])
  @@index([customerId])
  @@index([quotationId])
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("INFO")
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model RevenueTarget {
  id         String       @id @default(uuid())
  tenantId   String
  periodType TargetPeriod @default(MONTHLY)
  value      Decimal      @default(0) @db.Decimal(12, 2)
  currency   String       @default("USD")
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
}

model Note {
  id         String    @id @default(uuid())
  tenantId   String
  leadId     String
  userId     String
  message    String
  isPinned   Boolean   @default(false)
  mentions   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  isInternal Boolean   @default(true)
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User      @relation("NoteAuthor", fields: [userId], references: [id])

  @@index([tenantId])
  @@index([leadId])
  @@index([userId])
}

model TimelineEvent {
  id          String   @id @default(uuid())
  tenantId    String
  leadId      String
  userId      String?
  action      String
  description String?
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?    @relation("TimelineEventActor", fields: [userId], references: [id])

  @@index([tenantId])
  @@index([leadId])
}

model Attachment {
  id        String   @id @default(uuid())
  tenantId  String
  leadId    String
  userId    String
  fileName  String
  fileUrl   String
  fileSize  Int
  fileType  String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation("AttachmentUploader", fields: [userId], references: [id])

  @@index([tenantId])
  @@index([leadId])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerStatus {
  PREMIUM
  ACTIVE
  INACTIVE
}

enum LeadStage {
  NEW
  CONTACTED
  PROPOSAL_SENT
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
  OVERDUE
}

enum QuotationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  DRAFT
  SENT
  VIEWED
}

enum EventType {
  MEETING
  CALL
  HOLIDAY
  BIRTHDAY
  LEAVE
  FOLLOW_UP
}

enum TargetPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

model TenantAiConfig {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  provider          String   @default("gemini")
  model             String   @default("gemini-1.5-flash")
  apiKey            String?
  temperature       Float    @default(0.7)
  isAiEnabled       Boolean  @default(true)
  dailyTokenLimit   Int?
  monthlyTokenLimit Int?
  useRag            Boolean  @default(true)
  useTools          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AiConversation {
  id        String      @id @default(uuid())
  tenantId  String
  userId    String
  title     String?
  summary   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([tenantId])
  @@index([userId])
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String
  content        String
  toolCalls      Json?
  tokenCount     Int?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AiLog {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String
  provider       String
  model          String
  tokens         Int
  latencyMs      Int
  cost           Decimal? @db.Decimal(12, 6)
  promptVersion  String?
  toolCallsCount Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
}

model Document {
  id         String          @id @default(uuid())
  tenantId   String
  title      String
  content    String
  sourceUrl  String?
  metadata   Json?
  createdAt  DateTime        @default(now())
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks     DocumentChunk[]

  @@index([tenantId])
}

model DocumentChunk {
  id         String                  @id @default(uuid())
  documentId String
  content    String
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                @default(now())
  document   Document                @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

